    "pack": "node scripts/build-installer.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "7zip-bin": "5.2.0"
  }
}
