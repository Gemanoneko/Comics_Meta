{
  "name": "comic-metadata",
  "productName": "Comic Metadata",
  "version": "0.1.4",
  "description": "Personal comic metadata organizer",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "check:python": "node scripts/check-python.mjs",
